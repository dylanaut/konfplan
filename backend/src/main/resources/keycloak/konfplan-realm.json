{
  "realm": "konfplan",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["de"],
  "defaultLocale": "de",
  "actionTokenGeneratedByUserLifespan": 129600,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "eventsEnabled": true,
  "enabledEventTypes": ["LOGIN_ERROR", "SEND_RESET_PASSWORD_ERROR"],
  "eventsExpiration": 2592000,
  "roles": {
    "realm": [
      { "name": "ORGANISATOR", "description": "Organisator" },
      { "name": "ADMINISTRATOR", "description": "Administrator (Organisator mit exklusiven Rechten für Wartungshinweis und Verzeichnis-Import)" },
      { "name": "REFERENT", "description": "Referent (Vortragender)" },
      { "name": "TEILNEHMER", "description": "Teilnehmer" }
    ]
  },
  "clients": [
    {
      "clientId": "konfplan-frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:9000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:9000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "konfplan-backend",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "konfplan-admin-cli",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-secret"
    }
  ],
  "users": [
    {
      "username": "service-account-konfplan-admin-cli",
      "enabled": true,
      "serviceAccountClientId": "konfplan-admin-cli",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "view-realm", "manage-realm", "view-events"]
      }
    }
  ]
}
