[Unit]
Description=KonfPlan Veranstaltungsplanung
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=konfplan
Group=konfplan
EnvironmentFile=/etc/konfplan/konfplan.env
WorkingDirectory=/opt/konfplan
ExecStart=/usr/bin/java -jar /opt/konfplan/quarkus-app/quarkus-run.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Systemds Default-Grenze (haeufig 1024 offene Datei-Deskriptoren) reicht bei mehreren hundert
# gleichzeitigen HTTP-Verbindungen (siehe backend/.../application.properties, Connection-/
# Thread-Pool-Tuning fuer ~700 Nutzer) nicht mehr aus.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
