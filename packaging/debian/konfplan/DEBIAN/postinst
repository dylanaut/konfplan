#!/bin/sh
set -e

case "$1" in
    configure)
        if ! getent passwd konfplan > /dev/null 2>&1; then
            adduser --system --group --home /opt/konfplan --no-create-home \
                --shell /usr/sbin/nologin konfplan
        fi

        # Nur die eigenen Unterverzeichnisse chownen, nicht /var/lib/konfplan als
        # Ganzes - andere Pakete koennten dort eigene Verzeichnisse mit anderem
        # Owner anlegen.
        mkdir -p /opt/konfplan/logs
        chown -R konfplan:konfplan /opt/konfplan

        mkdir -p /var/lib/konfplan/import/veranstaltungen /var/lib/konfplan/templates
        chown -R konfplan:konfplan /var/lib/konfplan/import /var/lib/konfplan/templates

        chown root:konfplan /etc/konfplan/konfplan.env
        chmod 640 /etc/konfplan/konfplan.env

        systemctl daemon-reload || true
        systemctl enable konfplan.service || true

        echo ""
        echo "KonfPlan wurde installiert, aber noch NICHT gestartet."
        echo "Bitte zuerst /etc/konfplan/konfplan.env anpassen (DB_PASSWORD, KC_ADMIN_CLI_SECRET,"
        echo "ggf. BREVO_SMTP_* oder Mailpit-Werte) und dann starten mit:"
        echo "  sudo systemctl start konfplan.service"
        echo "Logs: journalctl -u konfplan.service -f"
        echo ""
        ;;
esac

exit 0
