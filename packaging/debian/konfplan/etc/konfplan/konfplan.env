# Konfiguration fuer den konfplan.service (systemd EnvironmentFile).
# Nach Aenderungen: sudo systemctl restart konfplan.service

QUARKUS_PROFILE=prod

# --- Datenbank (PostgreSQL, siehe konfplan-postgresql-Paket oder eigener Server) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=konfplan
DB_USER=konfplan
DB_PASSWORD=CHANGE_ME

# --- MiniZinc-Binary (vom minizinc-Debian-Paket bereitgestellt) ---
MINIZINC_PATH=/usr/bin/minizinc

# --- Keycloak (siehe konfplan-keycloak-Paket) ---
# KC_SERVER_URL muss mit KC_HOSTNAME:KEYCLOAK_PORT in keycloak.env uebereinstimmen.
# KC_ADMIN_CLI_SECRET muss mit dem gleichnamigen Wert in keycloak.env uebereinstimmen.
KC_SERVER_URL=http://localhost:8080
KC_REALM=konfplan
KC_ADMIN_CLI_SECRET=CHANGE_ME

# --- Mailversand ---
# Standard: Brevo-SMTP-Relay (siehe application.properties). Fuer lokale
# Installationen ohne externen SMTP-Dienst kann stattdessen das
# konfplan-mailpit-Paket genutzt werden - dann die folgenden vier Zeilen
# einkommentieren und die BREVO_SMTP_* Variablen leer lassen:
# QUARKUS_MAILER_HOST=localhost
# QUARKUS_MAILER_PORT=1025
# QUARKUS_MAILER_START_TLS=DISABLED
# QUARKUS_MAILER_USERNAME=test
# QUARKUS_MAILER_PASSWORD=test
BREVO_SMTP_USER=CHANGE_ME
BREVO_SMTP_PASSWORD=CHANGE_ME

# --- Ablagepfade ---
TEMPLATES_DIR=/var/lib/konfplan/templates
VERANSTALTUNG_IMPORT_PATH=/var/lib/konfplan/import/veranstaltungen
# Optionales News-Laufband auf der Login-Seite: Datei anlegen, um es zu befuellen (erste Zeile
# darf nicht leer sein), Datei loeschen/leeren, um es wieder auszublenden.
LAUFBAND_PATH=/var/lib/konfplan/laufband.txt

# --- Frontend-Basis-URL fuer Links in E-Mails (z.B. Einladung zu einer Veranstaltung) ---
# In Produktion wird das Frontend von Quinoa unter derselben Adresse wie das Backend
# ausgeliefert - hier die oeffentlich erreichbare URL dieser Installation eintragen.
# Muss mit APP_PUBLIC_URL in keycloak.env uebereinstimmen (Redirect-URI des Frontend-Clients).
FRONTEND_BASE_URL=CHANGE_ME
