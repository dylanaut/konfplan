# Konfiguration fuer den konfplan.service (systemd EnvironmentFile).
# Nach Aenderungen: sudo systemctl restart konfplan.service

QUARKUS_PROFILE=prod

# --- Datenbank (MS SQL Server, siehe konfplan-mssql-Paket oder eigener Server) ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=konfplan
DB_USER=sa
DB_PASSWORD=CHANGE_ME

# --- MiniZinc-Binary (vom minizinc-Debian-Paket bereitgestellt) ---
MINIZINC_PATH=/usr/bin/minizinc

# --- Mailversand ---
# Standard: Brevo-SMTP-Relay (siehe application.properties). Fuer lokale
# Installationen ohne externen SMTP-Dienst kann stattdessen das
# konfplan-mailpit-Paket genutzt werden - dann die folgenden vier Zeilen
# einkommentieren und die BREVO_SMTP_* Variablen leer lassen:
# QUARKUS_MAILER_HOST=localhost
# QUARKUS_MAILER_PORT=1025
# QUARKUS_MAILER_START_TLS=DISABLED
# QUARKUS_MAILER_USERNAME=test
# QUARKUS_MAILER_PASSWORD=test
BREVO_SMTP_USER=CHANGE_ME
BREVO_SMTP_PASSWORD=CHANGE_ME

# --- Ablagepfade ---
TEMPLATES_DIR=/var/lib/konfplan/templates
VERANSTALTUNG_IMPORT_PATH=/var/lib/konfplan/import/veranstaltungen
