# Konfiguration fuer konfplan-mssql.service (systemd EnvironmentFile).
# Nach Aenderungen: sudo systemctl restart konfplan-mssql.service

# Muss die SQL-Server-Passwortrichtlinie erfuellen: mind. 8 Zeichen aus 3 von
# 4 Zeichenklassen (Gross-/Kleinbuchstaben, Zahlen, Sonderzeichen).
MSSQL_SA_PASSWORD=CHANGE_ME_8chars_1Upper_1Digit_1Special

# Developer = kostenlos, alle Features, NICHT fuer Produktion lizenziert.
# Fuer echten Produktionsbetrieb: Express (kostenlos, limitiert auf 10 GB DB)
# oder eine lizenzierte Edition (Standard/Enterprise) verwenden.
MSSQL_PID=Developer

# Name der Datenbank, die beim ersten Start automatisch angelegt wird (SQL
# Server legt - anders als Postgres mit POSTGRES_DB - keine benannte Datenbank
# automatisch an). Muss mit DB_NAME in /etc/konfplan/konfplan.env uebereinstimmen.
DB_NAME=konfplan
