#!/bin/sh
set -e

case "$1" in
    remove)
        systemctl stop konfplan-mssql.service || true
        docker rm -f konfplan-mssql > /dev/null 2>&1 || true
        systemctl daemon-reload || true
        ;;
    purge)
        systemctl disable konfplan-mssql.service || true
        echo "Hinweis: Datenbankdateien unter /var/lib/konfplan/mssql-data wurden NICHT geloescht."
        echo "Manuell entfernen mit: sudo rm -rf /var/lib/konfplan/mssql-data"
        ;;
esac

exit 0
