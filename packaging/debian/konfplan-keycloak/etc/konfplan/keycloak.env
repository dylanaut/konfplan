# Konfiguration fuer konfplan-keycloak.service (systemd EnvironmentFile).
# Nach Aenderungen: sudo systemctl restart konfplan-keycloak.service
#
# DB_USER/DB_PASSWORD muessen mit den gleichnamigen Variablen in postgresql.env
# uebereinstimmen (Keycloak nutzt dieselbe PostgreSQL-Rolle, aber eine eigene
# Datenbank "keycloak" statt "konfplan" - siehe konfplan-postgresql).
DB_USER=konfplan
DB_PASSWORD=CHANGE_ME

# Admin-Login fuer die Keycloak-Admin-Konsole (Benutzername ist fest "admin").
KC_ADMIN_PASSWORD=CHANGE_ME

# Muss mit KC_ADMIN_CLI_SECRET in /etc/konfplan/konfplan.env uebereinstimmen -
# frei waehlbar, z.B. per "openssl rand -hex 32" erzeugen.
KC_ADMIN_CLI_SECRET=CHANGE_ME

# Oeffentlich erreichbarer Hostname dieser Keycloak-Instanz (ohne Schema/Port -
# Keycloak haengt intern http:// an, siehe KC_HTTP_ENABLED in der .service-Datei).
# Fuer eine erste lokale Installation ohne eigene Domain reicht "localhost".
KC_HOSTNAME=localhost

# Muss mit FRONTEND_BASE_URL in /etc/konfplan/konfplan.env uebereinstimmen -
# wird als Redirect-URI/Web-Origin des Frontend-Clients in den importierten
# Realm eingetragen.
APP_PUBLIC_URL=http://localhost:9000

# Port, unter dem Keycloak selbst (Login-Seite, Admin-Konsole, Token-Endpunkt)
# erreichbar ist - muss mit KC_SERVER_URL in konfplan.env uebereinstimmen.
KEYCLOAK_PORT=8080
