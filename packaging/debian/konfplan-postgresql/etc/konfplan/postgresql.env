# Konfiguration fuer konfplan-postgresql.service (systemd EnvironmentFile).
# Nach Aenderungen erneut ausfuehren: sudo systemctl start konfplan-postgresql.service
#
# DB_NAME und DB_USER muessen mit den gleichnamigen Variablen in
# /etc/konfplan/konfplan.env uebereinstimmen.

DB_NAME=konfplan
DB_USER=konfplan
DB_PASSWORD=CHANGE_ME
