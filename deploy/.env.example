# Kopieren nach ".env" und anpassen: "cp .env.example .env". Nur nicht-geheime Konfiguration -
# Passwörter kommen ausschließlich aus secrets/*.txt (siehe bootstrap.sh), NIE hierher.

# --- Image ---
# Von der CI nach ghcr.io/dylanaut/konfplan gepusht (siehe .github/workflows/ci.yml).
IMAGE_TAG=latest

# ============================================================================
# Lokal / UTM (kein öffentlicher Host) - Standardwerte, i.d.R. unveraendert lassen
# ============================================================================
# 127.0.0.1-Bindung ist sicher-per-Default (von außen nicht erreichbar); für Zugriff von
# anderen Geräten im selben LAN z.B. auf "9000:9000" (ohne IP-Praefix) aendern.
APP_PORT_BINDING=127.0.0.1:9000:9000
KEYCLOAK_PORT_BINDING=127.0.0.1:8080:8080
APP_PUBLIC_URL=http://localhost:9000
KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth

# ============================================================================
# Nur für Profil "public" (Hetzner/Internet) zusätzlich setzen:
# ============================================================================
# Nur EIN A-Record nötig (Keycloak läuft unter demselben Hostnamen unter dem Pfad /auth,
# siehe Caddyfile) - muss auf die IP dieses Servers zeigen.
#APP_HOSTNAME=konfplan.example.com
#APP_PUBLIC_URL=https://konfplan.example.com
#KEYCLOAK_PUBLIC_URL=https://konfplan.example.com/auth
#ACME_EMAIL=admin@example.com

# ============================================================================
# Mailversand: entweder Profil "mailpit" aktivieren (kein echter Versand, Test-Postfach unter
# http://localhost:8025) ODER hier einen echten SMTP-Server (z.B. Brevo) eintragen - das
# zugehörige Passwort kommt aus secrets/brevo_smtp_password.txt. Gilt sowohl für den Mailversand
# der App selbst als auch für Keycloaks eigenen "Passwort vergessen"-Mailversand (siehe
# keycloak-realm.template.json/bootstrap.sh) - beide nutzen dieselben Werte.
# ============================================================================
#BREVO_SMTP_USER=dein-brevo-login
#MAILER_HOST=smtp-relay.brevo.com
#MAILER_PORT=587
#MAILER_START_TLS=REQUIRED
