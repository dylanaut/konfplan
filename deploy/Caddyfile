{
	email {$ACME_EMAIL}
}

# App und Keycloak teilen sich eine Domain (nur ein A-Record nötig) - Keycloak läuft per
# KC_HTTP_RELATIVE_PATH selbst unter /auth, daher wird der Pfad hier unverändert (mit "handle",
# nicht "handle_path") durchgereicht statt umgeschrieben.

{$APP_HOSTNAME} {
	@keycloak path /auth*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}
	handle {
		reverse_proxy app:9000
	}
}
